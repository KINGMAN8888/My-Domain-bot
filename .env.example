# DomainRadar AI — Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.

# ── Telegram Bot (required) ───────────────────────────────
# Get these from @BotFather on Telegram
TELEGRAM_BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
TELEGRAM_CHAT_ID="YOUR_CHAT_ID_HERE"

# ── Google Gemini AI (optional — future AI scoring) ───────
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ── App Configuration ─────────────────────────────────────
ENVIRONMENT="development"         # development | production
DASHBOARD_URL="http://localhost:3000"
APP_URL="http://localhost:8000"

# ── CORS (comma-separated origins, use * for dev) ─────────
CORS_ORIGINS="*"
# Production example:
# CORS_ORIGINS="https://yourdomain.com,https://www.yourdomain.com"

# ── Worker Tuning ─────────────────────────────────────────
WORKER_INTERVAL="3600"   # seconds between scans (3600 = 1 hour)
MIN_SCORE_ALERT="80"     # minimum score to trigger alert (0-100)

# ── Server Port (used by Railway/Render/Fly.io) ───────────
PORT="8000"
